rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Role Helpers
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdminOrStaff() {
      return request.auth != null && (
        getRole() == 'admin' ||
        getRole() == 'staff' ||
        getRole() == 'cap_staff' ||
        getRole() == 'cap_supervisor'
      );
    }

    function isClientOwnerOrStaffOrPartner(clientId) {
      return request.auth != null && (
        request.auth.uid == clientId ||
        isAdminOrStaff() ||
        (resource != null && (resource.data.partnerId == request.auth.uid || resource.data.resellerId == request.auth.uid)) ||
        (request.resource != null && (request.resource.data.partnerId == request.auth.uid || request.resource.data.resellerId == request.auth.uid))
      );
    }

    // Collection Level Rules

    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId || 
        isAdminOrStaff() ||
        (resource != null && resource.data.partnerId == request.auth.uid)
      );
      allow write: if request.auth != null && (
        request.auth.uid == userId || 
        isAdminOrStaff() ||
        (resource != null && resource.data.partnerId == request.auth.uid) ||
        (request.resource != null && request.resource.data.partnerId == request.auth.uid)
      );
    }

    match /users/{userId}/serviceOverrides/{serviceId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdminOrStaff());
    }

    match /adminClients/{clientId} {
      allow read, write: if isClientOwnerOrStaffOrPartner(clientId); 
    }

    match /partnerClients/{clientId} {
      allow read, write: if isClientOwnerOrStaffOrPartner(clientId); 
    }

    match /aiPayrollClients/{clientId}/{document=**} {
      allow read, write: if isClientOwnerOrStaffOrPartner(clientId);
    }

    match /clients/{clientId} {
      allow read, write: if isClientOwnerOrStaffOrPartner(clientId); 
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdminOrStaff(); 
    }

    match /orders/{orderId} {
      allow read, write: if request.auth != null && (
        isAdminOrStaff() ||
        (resource != null && (resource.data.userId == request.auth.uid || resource.data.resellerId == request.auth.uid || resource.data.partnerId == request.auth.uid)) ||
        (request.resource != null && (request.resource.data.userId == request.auth.uid || request.resource.data.resellerId == request.auth.uid || request.resource.data.partnerId == request.auth.uid))
      ); 
    }

    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isAdminOrStaff();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdminOrStaff();
    }

    match /tasks/{taskId} {
      allow read, write: if request.auth != null && (
        isAdminOrStaff() ||
        (resource != null && (resource.data.userId == request.auth.uid || resource.data.clientId == request.auth.uid || resource.data.partnerId == request.auth.uid || resource.data.assignedTo == request.auth.uid)) ||
        (request.resource != null && (request.resource.data.userId == request.auth.uid || request.resource.data.clientId == request.auth.uid || request.resource.data.partnerId == request.auth.uid || request.resource.data.assignedTo == request.auth.uid))
      );
    }

    match /sequences/{sequenceId} {
      allow read, write: if request.auth != null;
    }

    match /discounts/{discountId} {
      allow read: if request.auth != null;
      allow write: if isAdminOrStaff();
    }

    match /complianceRequests/{requestId} {
      allow read, write: if request.auth != null && (
        isAdminOrStaff() ||
        (resource != null && (resource.data.userId == request.auth.uid || resource.data.clientId == request.auth.uid || resource.data.partnerId == request.auth.uid)) ||
        (request.resource != null && (request.resource.data.userId == request.auth.uid || request.resource.data.clientId == request.auth.uid || request.resource.data.partnerId == request.auth.uid))
      );
    }

    match /aiAccountantClients/{clientId}/{document=**} {
      allow read, write: if isClientOwnerOrStaffOrPartner(clientId);
    }

    match /numeraClients/{clientId}/{document=**} {
      allow read, write: if isClientOwnerOrStaffOrPartner(clientId);
    }

    match /extractedInvoices/{invoiceId} {
      allow read, write: if request.auth != null && (
        isAdminOrStaff() ||
        (resource != null && (resource.data.userId == request.auth.uid || resource.data.clientId == request.auth.uid || resource.data.partnerId == request.auth.uid)) ||
        (request.resource != null && (request.resource.data.userId == request.auth.uid || request.resource.data.clientId == request.auth.uid || request.resource.data.partnerId == request.auth.uid))
      );
    }

    match /processedEmails/{emailId} {
      allow read, write: if request.auth != null && (
        isAdminOrStaff() ||
        (resource != null && (resource.data.userId == request.auth.uid || resource.data.clientId == request.auth.uid)) ||
        (request.resource != null && (request.resource.data.userId == request.auth.uid || request.resource.data.clientId == request.auth.uid))
      );
    }

    match /allocationRules/{ruleId} {
      allow read, write: if request.auth != null;
    }

    match /unansweredQuestions/{questionId} {
      allow read, write: if request.auth != null;
    }

    match /cvLeads/{leadId} {
      allow read: if isAdminOrStaff();
      allow write: if true; 
    }

    match /demoLeads/{leadId} {
      allow read: if isAdminOrStaff();
      allow write: if true; 
    }
  }
}
